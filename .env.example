# Service Finder - Environment Variables Template
# Copy this file to .env and add your actual values
# .env file is in .gitignore and will NOT be pushed to GitHub

# API Keys (if needed in future)
# API_KEY=your_api_key_here
# SECRET_KEY=your_secret_key_here

# Database Configuration (if needed in future)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=service_finder
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password_here

# API Endpoints
# API_URL=https://api.example.com

# Email Configuration (if needed in future)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_email_password_here
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# GitHub Tokens (if needed in future)
# GITHUB_TOKEN=your_github_token_here

# Other sensitive data
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_token_here
